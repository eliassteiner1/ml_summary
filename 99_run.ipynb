   "source": [
    "import numpy as np\n",
    "\n",
    "\n",
    "A = np.random.rand(5, 5)\n",
    "\n",
    "A.dot(A).dot(A).dot(A)\n",
    "np.einsum(\"ij, jk, kl, lm -> im\", A, A, A, A)\n",
    "np.einsum(\"ij, jk, kl, lm -> im\", A, A, A, A, optimize=True)\n",
    "\n",
    "aaa = np.einsum_path(\"ij, jk, kl, lm -> im\", A, A, A, A, optimize=False)\n",
    "print(aaa)\n"
   ]
